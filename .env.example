# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
WEBHOOK_URL=your_discord_or_slack_webhook_here

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local dev:   postgresql://postgres:password@localhost:5432/tailoredresume
# Supabase:    postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/tailoredresume

# ── Authentication (Clerk) ────────────────────────────────────────────────────
# Find in Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Find in Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...

# ── Storage (Supabase) ────────────────────────────────────────────────────────
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Proxy (optional — for scraper rotation on cloud) ─────────────────────────
# Example: ScraperAPI proxy URL. Leave empty to disable.
PROXY_URL=

# ── Scoring thresholds ────────────────────────────────────────────────────────
SCORE_STRONG=7
SCORE_MAYBE=4

# ── Reliability settings ──────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SEC=1.0
RETRY_BACKOFF_FACTOR=2.0
HTTP_TIMEOUT_SEC=15

# ── Cache behavior ────────────────────────────────────────────────────────────
JOBS_CACHE_TTL_SEC=1800

# ── Legacy job search defaults (overridden by user_search_config DB table) ────
JOBSPY_SEARCH_TERM="Software Engineer"
JOBSPY_SITES="linkedin, indeed, glassdoor"
JOBSPY_LOCATION="Remote"
JOBSPY_LIMIT=20

# ── LLM Batching & Throttling ─────────────────────────────────────────────────
LLM_BATCH_SIZE=5
LLM_MAX_CONCURRENT_BATCHES=3
LLM_MIN_INTERVAL_SEC=2.0
LLM_RATE_LIMIT_COOLDOWN_SEC=60.0
LLM_MAX_DESC_CHARS=600

# ── Redis (Celery broker) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────────
# Add to web/.env.local:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_API_URL=http://localhost:8000
